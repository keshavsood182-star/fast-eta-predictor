{
  "project": "Zomato Fast ETA Predictor",
  "model_type": "Random Forest Regressor",
  "target": "Time_taken (min)",
  "distance_method": "Haversine",
  "features": [
    "Delivery_person_Age",
    "Delivery_person_Ratings",
    "Vehicle_condition",
    "multiple_deliveries",
    "Restaurant_latitude",
    "Restaurant_longitude",
    "Delivery_location_latitude",
    "Delivery_location_longitude",
    "distance_km",
    "order_hour",
    "order_day_of_week",
    "GPS_valid",
    "distance_valid",
    "order_time_missing",
    "Weather_conditions",
    "Road_traffic_density",
    "Type_of_order",
    "Type_of_vehicle",
    "Festival",
    "City"
  ],
  "categorical_features": [
    "Weather_conditions",
    "Road_traffic_density",
    "Type_of_order",
    "Type_of_vehicle",
    "Festival",
    "City"
  ],
  "hyperparameters": {
    "n_estimators": 150,
    "max_depth": 15,
    "min_samples_leaf": 1,
    "min_samples_split": 2,
    "max_features": 0.5,
    "random_state": 42
  },
  "validation_metrics": {
    "rmse_minutes": 4.058,
    "mae_minutes": 3.219,
    "r2": 0.817,
    "within_5_minutes_percent": 80.26
  },
  "test_metrics": {
    "rmse_minutes": 4.032,
    "mae_minutes": 3.214,
    "r2": 0.811,
    "within_5_minutes_percent": 80.38
  },
  "notes": [
    "Chronological train/validation/test split was used.",
    "Time_Order_picked was excluded because it occurs after order placement.",
    "Haversine distance is the production distance feature.",
    "Road-network distance was investigated separately and is not part of this model."
  ],
  "python_version": "3.13.16",
  "pandas_version": "2.2.3",
  "numpy_version": "2.1.3",
  "scikit_learn_version": "1.6.1"
}